---
// Språkväljaren visas bara på sidor som finns på både engelska och svenska (docs-internal#84).
import Default from '@astrojs/starlight/components/LanguageSelect.astro';
import sprak from '../generated/sprak.json';
const id = Astro.locals.starlightRoute.id.replace(/^sv(\/|$)/, '');
const visa = sprak.svenska.includes(id ? `sv/${id}` : 'sv');
---

{visa && <Default />}
